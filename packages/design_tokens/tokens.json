{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "CASA D'NINETY NINE Design Tokens",
    "version": "1.0.0",
    "status": "design-freeze"
  },
  "color": {
    "brand": {
      "navy": { "$value": "#0B3568", "$type": "color" },
      "navyDark": { "$value": "#06264D", "$type": "color" },
      "gold": { "$value": "#C99A43", "$type": "color" },
      "goldDark": { "$value": "#A97820", "$type": "color" }
    },
    "surface": {
      "canvas": { "$value": "#F7F8FA", "$type": "color" },
      "primary": { "$value": "#FFFFFF", "$type": "color" },
      "subtle": { "$value": "#EEF3F9", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "#0B2D5C", "$type": "color" },
      "secondary": { "$value": "#667495", "$type": "color" },
      "inverse": { "$value": "#FFFFFF", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "#168A45", "$type": "color" },
      "warning": { "$value": "#C98400", "$type": "color" },
      "error": { "$value": "#D92D32", "$type": "color" },
      "info": { "$value": "#1769AA", "$type": "color" },
      "disabled": { "$value": "#B8C2D3", "$type": "color" }
    },
    "border": {
      "default": { "$value": "#DDE3EC", "$type": "color" },
      "strong": { "$value": "#AAB6C9", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "Inter, system-ui, sans-serif", "$type": "fontFamily" }
    },
    "size": {
      "xs": { "$value": "12px", "$type": "dimension" },
      "sm": { "$value": "14px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "20px", "$type": "dimension" },
      "xl": { "$value": "24px", "$type": "dimension" },
      "2xl": { "$value": "32px", "$type": "dimension" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "number" },
      "medium": { "$value": 500, "$type": "number" },
      "semibold": { "$value": 600, "$type": "number" },
      "bold": { "$value": 700, "$type": "number" }
    }
  },
  "spacing": {
    "0": { "$value": "0px", "$type": "dimension" },
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "xl": { "$value": "24px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "elevation": {
    "card": { "$value": "0 6px 24px rgba(11, 53, 104, 0.08)", "$type": "shadow" },
    "overlay": { "$value": "0 16px 48px rgba(11, 53, 104, 0.18)", "$type": "shadow" }
  },
  "motion": {
    "fast": { "$value": "120ms", "$type": "duration" },
    "normal": { "$value": "200ms", "$type": "duration" },
    "slow": { "$value": "320ms", "$type": "duration" }
  },
  "layout": {
    "mobileContentPadding": { "$value": "24px", "$type": "dimension" },
    "desktopSidebar": { "$value": "264px", "$type": "dimension" },
    "touchTargetMin": { "$value": "48px", "$type": "dimension" }
  }
}
